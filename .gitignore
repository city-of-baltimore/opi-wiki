# >>> patapsco baseline ignore block v1 — managed by platform-check; edit outside the markers >>>
# Environment files and secrets. Only reviewed, non-secret examples come back.
.env
.env.*
.envrc
!.env.example
!.env.template
!.env.*.example

# Python environments, bytecode, tool caches, coverage, and package output.
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.eggs/
*.egg-info/
build/
dist/

# Node installs, build output, Vite/TypeScript caches, coverage, and browser output.
node_modules/
.vite/
*.tsbuildinfo
.eslintcache
coverage/
playwright-report/
test-results/
npm-debug.log*

# TLS private material and local CA output. A pattern with an interior
# separator is already anchored to this file's directory, and the directory
# itself stays tracked so a container always has a bind-mount target.
*.pem
*.key
certs/*
!certs/.gitkeep

# Local databases, static collection, media/uploads, logs, and guarded runtime
# evidence. `/var/*` rather than `/var/` on purpose: Git cannot re-include a
# path underneath an excluded directory, and a reviewed evidence record must
# stay re-includable by a repo-local exception after this block.
*.sqlite3
*.sqlite3-journal
staticfiles/
/media/
*.log
/var/*

# Operating-system and editor state.
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# The one canonical scratch spelling. Unrestricted `*scratch*` also hides
# `scratchpad_service.py` and `building-from-scratch.md`, so scratch is a
# suffix or a dedicated directory, never a substring.
*.scratch
*.scratch.*
/.scratch/
# <<< patapsco baseline ignore block v1 <<<

# --- opi-wiki additions. Everything above is Patapsco's managed block, carried
# --- verbatim; everything below is genuinely local to this repository.

# MkDocs build output. Anchored: only the repository-root site/ is generated,
# and docs/ content is free to use the word elsewhere.
/site/

# uv's local cache, when UV_CACHE_DIR points inside the checkout.
/.cache/

# Local working notes. Not site source, and never committed.
/notes/

# Claude Code local settings and dev-server config.
/.claude/
